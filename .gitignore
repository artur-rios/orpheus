# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# What the installer builds produce. Release artifacts are attached to a
# GitHub release by .github/workflows/release.yml, never committed.
/dist/

# The Android release signing key, and anything it was encoded into. Neither is
# ever committed — see the Releases section of README.md, which tells you to
# make both of them right here. `android/.gitignore` covers that directory; this
# covers the one the instructions actually put them in.
*.jks
*.keystore
key.properties
keystore.base64.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The documentation site's build output and dependencies. The site is built and
# published by .github/workflows/docs.yml; none of this belongs in the history.
/docs/site/public/
/docs/site/resources/
/docs/site/node_modules/
/docs/site/.hugo_build.lock
